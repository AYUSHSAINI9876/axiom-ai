# Deployment image: ONNX embeddings, no torch.
#
# The default Dockerfile builds the full local-development stack
# (sentence-transformers + torch + bge-large, well over a gigabyte). This one
# installs requirements-lite.txt instead and pins EMBED_BACKEND=fastembed, which
# fits in the memory a small managed instance actually provides.
#
# Build with:  docker build -f Dockerfile.lite -t axiom-ml-service:lite .
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    EMBED_BACKEND=fastembed \
    # fastembed caches its ONNX weights here; keep it inside /app so the
    # non-root user owns it.
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

# No build-essential: every wheel in requirements-lite.txt ships prebuilt for
# manylinux, which is what keeps this image small and the build fast.
COPY requirements-lite.txt .
RUN pip install --no-cache-dir -r requirements-lite.txt

COPY . .

RUN useradd --create-home --uid 1000 axiom \
    && mkdir -p /app/data/docs /app/storage /app/.cache/fastembed /app/.cache/huggingface \
    && chown -R axiom:axiom /app

USER axiom

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)" || exit 1

# Managed hosts inject the port to listen on; default to 8000 for a local run.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
