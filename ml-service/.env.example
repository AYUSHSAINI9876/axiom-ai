# Qdrant vector database URL
QDRANT_URL=http://localhost:6333

# Ollama base URL (used when GROQ_API_KEY is not set)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: if set, uses a Groq-hosted model instead of local Ollama
GROQ_API_KEY=

# Directory documents are read from / uploaded into
DATA_DIR=./data/docs

# Directory the docstore/index metadata is persisted to (survives container restarts)
PERSIST_DIR=./storage
