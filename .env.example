# Copy to .env and adjust as needed. Every value below is optional —
# `docker compose up` works with none of them set.

# ---- LLM backend ----
# If set, Axiom uses Groq-hosted Llama 3. If empty, it falls back to local Ollama
# (requires `ollama pull llama3` on the host).
GROQ_API_KEY=

# ---- Frontend ----
# Gateway base URL baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
