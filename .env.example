# Copy to .env and adjust as needed. `docker compose up` works with none of
# these set — every value below has a working default.

# ---- Authentication ----
# Signs access tokens (HS256). If unset, the gateway generates a random secret
# at startup and logs a warning: everything works, but every restart signs
# everyone out. Generate a real one for anything long-lived:
#   openssl rand -base64 32
JWT_SECRET=

# Password for the Compose-managed Postgres that stores accounts and refresh
# tokens. Only used locally; a managed host provides its own DATABASE_URL.
POSTGRES_PASSWORD=axiom-local-dev

# ---- LLM backend ----
# If set, Axiom uses Groq-hosted Llama 3 and Ollama is not needed at all.
# This is the easiest option on a machine with limited RAM: get a free key at
# https://console.groq.com/keys
GROQ_API_KEY=

# Otherwise Axiom uses local Ollama (`ollama pull llama3`). llama3 needs about
# 4GB of free memory to load; on a smaller machine pull a lighter model and
# name it here, e.g.  ollama pull llama3.2:3b
LLM_MODEL=

# ---- Embeddings ----
# `fastembed` (default) runs quantized BGE through onnxruntime: small, fast, no
# torch. `huggingface` uses sentence-transformers with BAAI/bge-large for better
# retrieval, at the cost of a much larger image and ~1.3GB of weights.
EMBED_BACKEND=

# ---- Frontend ----
# Gateway base URL baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
